    // Fragment: ERP multi-tenant rules only (Sokany store / files collections excluded). Paste inside `match /databases/{database}/documents { ... }`.
    // Helpers use the `pl_` prefix for safe merge into a central rules file.
    // No rules_version / service wrapper / match databases wrapper / deny-all catch-all in this file.

    function pl_authSignedIn() {
      return request.auth != null;
    }

    function pl_currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function pl_tenantId() {
      return pl_currentUserDoc().data.tenantId;
    }

    function pl_currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function pl_currentRolePath() {
      return /databases/$(database)/documents/roles/$(pl_currentUserDoc().data.roleId);
    }

    function pl_currentRoleDoc() {
      return get(pl_currentRolePath());
    }

    function pl_isSuperAdmin() {
      return pl_authSignedIn()
        && exists(pl_currentUserPath())
        && pl_currentUserDoc().data.isSuperAdmin == true;
    }

    function pl_roleBelongsToTenant() {
      let rid = pl_currentUserDoc().data.roleId;
      return rid != null && rid != ''
        && exists(/databases/$(database)/documents/roles/$(rid))
        && get(/databases/$(database)/documents/roles/$(rid)).data.tenantId
          == pl_currentUserDoc().data.tenantId;
    }

    function pl_hasErpPermission(permissionKey) {
      return pl_authSignedIn()
        && exists(pl_currentUserPath())
        && exists(pl_currentRolePath())
        && pl_roleBelongsToTenant()
        && permissionKey in pl_currentRoleDoc().data.permissions
        && pl_currentRoleDoc().data.permissions[permissionKey] == true;
    }

    function pl_isActiveUser() {
      return pl_authSignedIn()
        && exists(pl_currentUserPath())
        && pl_currentUserDoc().data.isActive == true;
    }

    function pl_sameTenantWrite() {
      return pl_isActiveUser()
        && request.resource.data.keys().hasAll(['tenantId'])
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId;
    }

    function pl_sameTenantUpdate() {
      return pl_isActiveUser()
        && resource.data.tenantId == pl_currentUserDoc().data.tenantId
        && request.resource.data.keys().hasAll(['tenantId'])
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId;
    }

    /** During migration, docs may lack tenantId; treat as single-tenant legacy (backfill tenantId for strict multi-tenant isolation). */
    function pl_sameTenantOrLegacyRead() {
      return pl_isActiveUser()
        && (
          resource == null
          || !('tenantId' in resource.data)
          || resource.data.tenantId == pl_currentUserDoc().data.tenantId
        );
    }

    function pl_sameTenantOrLegacyWrite() {
      return pl_isActiveUser()
        && request.resource.data.keys().hasAll(['tenantId'])
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId;
    }

    function pl_sameTenantOrLegacyUpdate() {
      return pl_isActiveUser()
        && (!('tenantId' in resource.data)
          || resource.data.tenantId == pl_currentUserDoc().data.tenantId)
        && request.resource.data.keys().hasAll(['tenantId'])
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId;
    }

    function pl_validSearchPrefixes() {
      return !('searchPrefixes' in request.resource.data)
        || (request.resource.data.searchPrefixes is list
          && request.resource.data.searchPrefixes.size() <= 80);
    }

    function pl_isRepairBranchAdmin() {
      return pl_hasErpPermission('repair.branches.manage');
    }

    function pl_currentUserRepairBranchId() {
      return pl_currentUserDoc().data.repairBranchId;
    }

    function pl_currentUserRepairBranchIds() {
      return pl_currentUserDoc().data.repairBranchIds;
    }

    function pl_currentUserHasRepairBranch(branchId) {
      return (
        (pl_currentUserRepairBranchId() != null
          && pl_currentUserRepairBranchId() != ''
          && branchId == pl_currentUserRepairBranchId())
        || (pl_currentUserRepairBranchIds() is list
          && branchId in pl_currentUserRepairBranchIds())
      );
    }

    function pl_isTechnicianAssignedToBranch(branchId) {
      return branchId != null
        && branchId != ''
        && exists(/databases/$(database)/documents/repair_branches/$(branchId))
        && (
          get(/databases/$(database)/documents/repair_branches/$(branchId)).data.technicianIds is list
          && request.auth.uid in get(/databases/$(database)/documents/repair_branches/$(branchId)).data.technicianIds
        );
    }

    /**
     * Reception/desk may assign any technicianId (service validates branch list).
     * Self-assign (technicianId == auth.uid) is only for branch technicians —
     * blocks «إسناد لي» for reception staff who are not on technicianIds.
     */
    function pl_repairJobTechnicianSelfAssignOk() {
      return !('technicianId' in request.resource.data)
        || request.resource.data.get('technicianId', '') == resource.data.get('technicianId', '')
        || request.resource.data.get('technicianId', '') == ''
        || request.resource.data.get('technicianId', '') != request.auth.uid
        || (
          'branchId' in resource.data
          && pl_isTechnicianAssignedToBranch(resource.data.branchId)
        );
    }

    function pl_isBranchManager(branchId) {
      return branchId != null
        && branchId != ''
        && exists(/databases/$(database)/documents/repair_branches/$(branchId))
        && (
          get(/databases/$(database)/documents/repair_branches/$(branchId)).data.managerEmployeeId is string
          && get(/databases/$(database)/documents/repair_branches/$(branchId)).data.managerEmployeeId != ''
          && exists(
            /databases/$(database)/documents/employees/
            $(get(/databases/$(database)/documents/repair_branches/$(branchId)).data.managerEmployeeId)
          )
          && get(
            /databases/$(database)/documents/employees/
            $(get(/databases/$(database)/documents/repair_branches/$(branchId)).data.managerEmployeeId)
          ).data.userId == request.auth.uid
        );
    }

    /**
     * Center warehouse operators are often bound via users.inventoryWarehouseId
     * without users.repairBranchIds — allow the linked repair branch only.
     */
    function pl_isBoundToRepairBranchWarehouse(branchId) {
      return pl_isInventoryWarehouseBound()
        && branchId != null
        && branchId != ''
        && exists(/databases/$(database)/documents/repair_branches/$(branchId))
        && get(/databases/$(database)/documents/repair_branches/$(branchId)).data.get('warehouseId', '')
          == pl_boundInventoryWarehouseId();
    }

    function pl_canViewAllRepairBranches() {
      return pl_isRepairBranchAdmin()
        || pl_hasErpPermission('repair.callCenter.viewAll');
    }

    function pl_canReadRepairComplaintScoped() {
      return pl_sameTenantOrLegacyRead()
        && (
          pl_hasErpPermission('repair.complaints.manage')
          ||
          pl_canViewAllRepairBranches()
          || (
            'branchId' in resource.data
            && pl_canAccessRepairBranch(resource.data.branchId)
          )
        );
    }

    function pl_canWriteRepairComplaintScoped() {
      return pl_sameTenantOrLegacyWrite()
        && (
          pl_hasErpPermission('repair.complaints.manage')
          ||
          pl_canViewAllRepairBranches()
          || (
            'branchId' in request.resource.data
            && pl_canAccessRepairBranch(request.resource.data.branchId)
          )
        );
    }

    function pl_canUpdateRepairComplaintScoped() {
      return pl_sameTenantOrLegacyUpdate()
        && (
          pl_hasErpPermission('repair.complaints.manage')
          ||
          pl_canViewAllRepairBranches()
          || (
            'branchId' in resource.data
            && 'branchId' in request.resource.data
            && pl_canAccessRepairBranch(resource.data.branchId)
            && pl_canAccessRepairBranch(request.resource.data.branchId)
          )
        );
    }

    function pl_canAccessRepairBranch(branchId) {
      return pl_currentUserHasRepairBranch(branchId)
        || pl_isTechnicianAssignedToBranch(branchId)
        || pl_isBranchManager(branchId)
        || pl_isBoundToRepairBranchWarehouse(branchId);
    }

    function pl_canReadRepairBranchScoped() {
      return pl_sameTenantOrLegacyRead()
        && (
          pl_isRepairBranchAdmin()
          || (
            'branchId' in resource.data
            && pl_canAccessRepairBranch(resource.data.branchId)
          )
        );
    }

    function pl_canCreateRepairBranchScoped() {
      return pl_sameTenantOrLegacyWrite()
        && (
          pl_isRepairBranchAdmin()
          || (
            'branchId' in request.resource.data
            && pl_canAccessRepairBranch(request.resource.data.branchId)
          )
        );
    }

    function pl_canUpdateRepairBranchScoped() {
      return pl_sameTenantOrLegacyUpdate()
        && (
          pl_isRepairBranchAdmin()
          || (
            'branchId' in resource.data
            && 'branchId' in request.resource.data
            && pl_canAccessRepairBranch(resource.data.branchId)
            && pl_canAccessRepairBranch(request.resource.data.branchId)
          )
        );
    }

    /** Missing availableForSpareParts = allowed (backward compatible). */
    function pl_materialAvailableForSpareParts(materialId) {
      return materialId is string
        && materialId != ''
        && exists(/databases/$(database)/documents/materials/$(materialId))
        && (
          !('availableForSpareParts' in get(/databases/$(database)/documents/materials/$(materialId)).data)
          || get(/databases/$(database)/documents/materials/$(materialId)).data.availableForSpareParts != false
        );
    }

    function pl_repairSparePartMaterialLinkOk() {
      return !('materialId' in request.resource.data)
        || !(request.resource.data.materialId is string)
        || request.resource.data.materialId == ''
        || (
          request.method == 'update'
          && 'materialId' in resource.data
          && resource.data.materialId == request.resource.data.materialId
        )
        || pl_materialAvailableForSpareParts(request.resource.data.materialId);
    }

    /** Single-warehouse bind on users.inventoryWarehouseId (UI + rules). Empty = all warehouses. */
    function pl_boundInventoryWarehouseId() {
      return pl_currentUserDoc().data.get('inventoryWarehouseId', '');
    }

    function pl_isInventoryWarehouseBound() {
      return pl_boundInventoryWarehouseId() is string
        && pl_boundInventoryWarehouseId() != '';
    }

    function pl_canAccessInventoryWarehouse(warehouseId) {
      return !pl_isInventoryWarehouseBound()
        || (warehouseId is string && warehouseId != '' && warehouseId == pl_boundInventoryWarehouseId());
    }

    /**
     * List/count-safe warehouse gate: unbound users must not force resource.data evaluation,
     * otherwise RunAggregationQuery hits permission-denied (often via the 1000-expression cap).
     */
    function pl_inventoryWarehouseUnboundOr(docWarehouseReadable) {
      return pl_isSuperAdmin()
        || !pl_isInventoryWarehouseBound()
        || docWarehouseReadable;
    }

    /**
     * Compact permission OR (single role doc read) — avoids repeating pl_hasErpPermission
     * which re-expands exists/get/roleBelongsToTenant and blows the expression budget on list/count.
     */
    function pl_rolePermMapOk() {
      return pl_authSignedIn()
        && exists(pl_currentUserPath())
        && exists(pl_currentRolePath())
        && pl_roleBelongsToTenant();
    }

    function pl_rolePermTrue(permissions, key) {
      return key in permissions && permissions[key] == true;
    }

    function pl_canReadSparePartsReplenishmentPerm() {
      let p = pl_currentRoleDoc().data.permissions;
      return pl_isSuperAdmin()
        || (
          pl_rolePermMapOk()
          && (
            pl_rolePermTrue(p, 'sparePartsReplenishment.view')
            || pl_rolePermTrue(p, 'sparePartsReplenishment.create')
            || pl_rolePermTrue(p, 'sparePartsReplenishment.receive')
            || pl_rolePermTrue(p, 'inventory.view')
          )
        );
    }

    /** Matches the purchase-invoice page + post callable permission keys. */
    function pl_canReadSparePartsPurchaseInvoicePerm() {
      let p = pl_currentRoleDoc().data.permissions;
      return pl_isSuperAdmin()
        || (
          pl_rolePermMapOk()
          && (
            pl_rolePermTrue(p, 'inventory.transactions.create')
            || pl_rolePermTrue(p, 'sparePartsReplenishment.prepare')
            || pl_rolePermTrue(p, 'sparePartsReplenishment.view')
            || pl_rolePermTrue(p, 'repair.parts.manage')
            || pl_rolePermTrue(p, 'inventory.view')
          )
        );
    }

    function pl_canReadRepairSpareIssuePerm() {
      let p = pl_currentRoleDoc().data.permissions;
      return pl_isSuperAdmin()
        || (
          pl_rolePermMapOk()
          && (
            pl_rolePermTrue(p, 'repairSpareIssues.view')
            || pl_rolePermTrue(p, 'repair.parts.view')
            || pl_rolePermTrue(p, 'repair.view')
          )
        );
    }

    /** Manual center stock qty change / delete — inventory & multi-center admins, not branch-only managers. */
    function pl_canAdjustRepairCenterStock() {
      let p = pl_currentRoleDoc().data.permissions;
      return pl_isSuperAdmin()
        || (
          pl_rolePermMapOk()
          && (
            pl_rolePermTrue(p, 'repair.parts.stockAdjust')
            || pl_rolePermTrue(p, 'inventory.counts.manage')
            || pl_rolePermTrue(p, 'repair.adminDashboard.view')
            || pl_rolePermTrue(p, 'repair.branches.manage')
          )
        );
    }

    function pl_canReadWarehouseIdField() {
      return pl_sameTenantOrLegacyRead()
        && pl_canAccessInventoryWarehouse(resource.data.get('warehouseId', ''));
    }

    function pl_canWriteWarehouseIdField() {
      return pl_sameTenantOrLegacyWrite()
        && pl_canAccessInventoryWarehouse(request.resource.data.get('warehouseId', ''));
    }

    function pl_canUpdateWarehouseIdField() {
      return pl_sameTenantOrLegacyUpdate()
        && pl_canAccessInventoryWarehouse(resource.data.get('warehouseId', ''))
        && pl_canAccessInventoryWarehouse(request.resource.data.get('warehouseId', ''));
    }

    function pl_canReadTransferWarehouses() {
      return pl_sameTenantOrLegacyRead()
        && (
          pl_canAccessInventoryWarehouse(resource.data.get('fromWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('toWarehouseId', ''))
        );
    }

    function pl_canWriteTransferWarehouses() {
      return pl_sameTenantOrLegacyWrite()
        && (
          pl_canAccessInventoryWarehouse(request.resource.data.get('fromWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(request.resource.data.get('toWarehouseId', ''))
        );
    }

    function pl_canUpdateTransferWarehouses() {
      return pl_sameTenantOrLegacyUpdate()
        && resource.data.get('fromWarehouseId', '')
          == request.resource.data.get('fromWarehouseId', '')
        && resource.data.get('toWarehouseId', '')
          == request.resource.data.get('toWarehouseId', '')
        && (
          pl_canAccessInventoryWarehouse(resource.data.get('fromWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('toWarehouseId', ''))
        );
    }

    function pl_canReadIssueWarehouses() {
      return pl_sameTenantOrLegacyRead()
        && (
          pl_canAccessInventoryWarehouse(resource.data.get('sourceWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('targetWarehouseId', ''))
        );
    }

    function pl_canWriteIssueWarehouses() {
      return pl_sameTenantOrLegacyWrite()
        && pl_canAccessInventoryWarehouse(request.resource.data.get('sourceWarehouseId', ''));
    }

    function pl_canUpdateIssueWarehouses() {
      return pl_sameTenantOrLegacyUpdate()
        && pl_canAccessInventoryWarehouse(resource.data.get('sourceWarehouseId', ''))
        && pl_canAccessInventoryWarehouse(request.resource.data.get('sourceWarehouseId', ''));
    }

    function pl_canReadDisassemblyWarehouses() {
      return pl_sameTenantOrLegacyRead()
        && (
          pl_canAccessInventoryWarehouse(resource.data.get('sourceWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('targetWarehouseId', ''))
        );
    }

    function pl_canWriteDisassemblyWarehouses() {
      return pl_sameTenantOrLegacyWrite()
        && pl_canAccessInventoryWarehouse(request.resource.data.get('sourceWarehouseId', ''))
        && pl_canAccessInventoryWarehouse(request.resource.data.get('targetWarehouseId', ''));
    }

    function pl_canUpdateDisassemblyWarehouses() {
      return pl_sameTenantOrLegacyUpdate()
        && pl_canAccessInventoryWarehouse(resource.data.get('sourceWarehouseId', ''))
        && pl_canAccessInventoryWarehouse(resource.data.get('targetWarehouseId', ''))
        && pl_canAccessInventoryWarehouse(request.resource.data.get('sourceWarehouseId', ''))
        && pl_canAccessInventoryWarehouse(request.resource.data.get('targetWarehouseId', ''));
    }

    function pl_canReadWarehouseDoc(warehouseDocId) {
      return pl_sameTenantOrLegacyRead()
        && pl_canAccessInventoryWarehouse(warehouseDocId);
    }

    function pl_canWriteWarehouseDoc(warehouseDocId) {
      return pl_sameTenantOrLegacyWrite()
        && pl_canAccessInventoryWarehouse(warehouseDocId);
    }

    function pl_canUpdateWarehouseDoc(warehouseDocId) {
      return pl_sameTenantOrLegacyUpdate()
        && pl_canAccessInventoryWarehouse(warehouseDocId);
    }

    /**
     * Bound spare-parts central operators need destination center warehouse docs
     * for replenishment dropdowns — warehouses collection only (not stock_*).
     * List queries must constrain tenantId + warehouseRole; do not get() the listed doc.
     */
    function pl_isBoundSparePartsCentralWarehouse() {
      return pl_isInventoryWarehouseBound()
        && exists(/databases/$(database)/documents/warehouses/$(pl_boundInventoryWarehouseId()))
        && get(/databases/$(database)/documents/warehouses/$(pl_boundInventoryWarehouseId()))
          .data.get('warehouseRole', '') == 'spare_parts_central';
    }

    function pl_canReadMaintenanceCenterWarehouseAsCentral() {
      return pl_isBoundSparePartsCentralWarehouse()
        && pl_sameTenantOrLegacyRead()
        && resource.data.get('warehouseRole', '') == 'maintenance_center';
    }

    function pl_canCreateRepairTreasuryEntryForOpenSession() {
      return (
        'sessionId' in request.resource.data
        && exists(
          /databases/$(database)/documents/repair_treasury_sessions/$(request.resource.data.sessionId)
        )
        && get(
          /databases/$(database)/documents/repair_treasury_sessions/$(request.resource.data.sessionId)
        ).data.branchId == request.resource.data.branchId
        && get(
          /databases/$(database)/documents/repair_treasury_sessions/$(request.resource.data.sessionId)
        ).data.status == 'open'
        && (
          !('needsManualClose' in get(
            /databases/$(database)/documents/repair_treasury_sessions/$(request.resource.data.sessionId)
          ).data)
          || get(
            /databases/$(database)/documents/repair_treasury_sessions/$(request.resource.data.sessionId)
          ).data.needsManualClose != true
        )
      );
    }

    /**
     * Gradual hardening (after backfillTenantId / data audit):
     * 1. Ensure all business docs in production have tenantId set.
     * 2. Replace pl_sameTenantOrLegacyRead with sameTenant on read for pl_isErpBusinessCollection.
     * 3. Replace pl_sameTenantOrLegacyUpdate with pl_sameTenantUpdate where legacy reads are no longer needed.
     * 4. Keep payroll_* on legacy helpers until those collections are fully migrated.
     */

    function pl_isErpBusinessCollection(coll) {
      return coll in [
        'products', 'production_lines', 'productionLines', 'employees', 'production_reports',
        'production_approval_requests',
        'line_status', 'line_product_config', 'production_plans', 'production_plan_followups',
        'supervisors', 'supervisor_line_assignments', 'supervisorAssignmentLog',
        'production_workers', 'production_line_worker_assignments', 'production_worker_targets',
        'worker_performance_summaries', 'worker_daily_performance_logs', 'production_attendance_records',
        'work_orders', 'notifications', 'scan_events', 'product_materials',
        'materials', 'boms', 'bom_items', 'material_requirement_runs',
        'production_plan_material_requirements', 'purchase_orders',
        'cost_deviation_analysis',
        'line_worker_assignments', 'raw_materials',
        'component_scrap_records',
        'labor_settings', 'assets', 'asset_depreciations',
        'activity_logs', 'departments', 'job_positions', 'shifts', 'hr_settings',
        'penalty_rules', 'late_rules', 'allowance_types', 'attendance_raw_logs', 'attendance_logs',
        'attendance_records', 'attendance_monthly_summaries', 'attendance_import_history',
        'employee_allowances',
        'vehicles', 'approval_settings',
        'employee_performance', 'employee_bonuses',
        'quality_settings', 'quality_reason_catalog', 'quality_workers_assignments',
        'quality_inspections', 'quality_defects', 'quality_rework_orders', 'quality_capa', 'quality_print_logs',
        'customers', 'customer_activities',
        'production_report_uniques', 'product_categories', 'material_categories', 'automation_runs', 'backups',
        'production_routing_plans', 'production_routing_steps',
        'supply_cycles', 'supply_cycle_waste_lines',
        'entity_code_counters', 'entity_code_claims', 'inventory_counters'
      ];
    }

    /**
     * Super admins may work inside another company via /t/{slug}/… while their users/{uid}.tenantId
     * stays on a home tenant. Generic business rules must still allow tenant-scoped docs.
     */
    function pl_superAdminTenantScopedCreateOk() {
      return pl_isSuperAdmin()
        && request.resource.data.keys().hasAll(['tenantId'])
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != '';
    }

    function pl_superAdminTenantScopedUpdateOk() {
      return pl_isSuperAdmin()
        && (
          !('tenantId' in resource.data)
          || !('tenantId' in request.resource.data)
          || request.resource.data.tenantId == resource.data.tenantId
        );
    }

    function pl_canManageHrConfigModule(moduleId) {
      return pl_isSuperAdmin()
        || pl_hasErpPermission('hrSettings.edit')
        || pl_hasErpPermission('settings.edit')
        || (moduleId == 'leave' && pl_hasErpPermission('leave.manage'));
    }

    function pl_canCreateHrConfigAuditLog() {
      return pl_isSuperAdmin()
        || pl_hasErpPermission('hrSettings.edit')
        || pl_hasErpPermission('settings.edit')
        || (
          'module' in request.resource.data
          && request.resource.data.module is string
          && request.resource.data.module == 'leave'
          && pl_hasErpPermission('leave.manage')
        );
    }

    function pl_hasSupervisorRequestPermission() {
      return pl_hasErpPermission('employeeDashboard.view')
        || pl_hasErpPermission('quickAction.view')
        || pl_hasErpPermission('production.workerReports.view')
        || pl_hasErpPermission('reports.create')
        || pl_hasErpPermission('leave.manage')
        || pl_hasErpPermission('approval.view')
        || pl_hasErpPermission('approval.manage');
    }

    function pl_hasApprovalReadPermission() {
      return pl_hasErpPermission('approval.view')
        || pl_hasErpPermission('approval.manage')
        || pl_hasErpPermission('approval.override')
        || pl_hasErpPermission('approval.escalate');
    }

    function pl_hasApprovalWritePermission() {
      return pl_hasErpPermission('approval.view')
        || pl_hasErpPermission('approval.manage')
        || pl_hasErpPermission('approval.override');
    }

    function pl_hasProductionApprovalReadAllPermission() {
      return pl_hasErpPermission('production.workers.manage')
        || pl_hasErpPermission('production.workerReports.view')
        || pl_hasErpPermission('leave.manage')
        || pl_hasErpPermission('approval.view')
        || pl_hasErpPermission('approval.manage');
    }

    function pl_isApprovalParticipantDoc() {
      return pl_authSignedIn()
        && 'participantUserIds' in resource.data
        && resource.data.participantUserIds is list
        && resource.data.participantUserIds.hasAny([request.auth.uid]);
    }

    function pl_isCurrentApprovalActorDoc() {
      return pl_authSignedIn()
        && 'currentApproverUserIds' in resource.data
        && resource.data.currentApproverUserIds is list
        && resource.data.currentApproverUserIds.hasAny([request.auth.uid]);
    }

    function pl_isCurrentApprovalActionUpdate() {
      return pl_isCurrentApprovalActorDoc()
        && resource.data.status in ['pending', 'in_progress', 'escalated']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalChain', 'currentStep', 'status', 'updatedAt', 'history',
          'currentApproverEmployeeIds', 'currentApproverUserIds',
          'participantEmployeeIds', 'participantUserIds'
        ])
        && request.resource.data.history is list
        && resource.data.history is list
        && request.resource.data.history.size() == resource.data.history.size() + 1;
    }

    function pl_isConfiguredProductionRequestObserverDoc() {
      return pl_authSignedIn()
        && 'tenantId' in resource.data
        && exists(/databases/$(database)/documents/system_settings/$(resource.data.tenantId))
        && 'planSettings' in get(/databases/$(database)/documents/system_settings/$(resource.data.tenantId)).data
        && 'productionRequestObserverUserIds' in get(/databases/$(database)/documents/system_settings/$(resource.data.tenantId)).data.planSettings
        && get(/databases/$(database)/documents/system_settings/$(resource.data.tenantId)).data.planSettings.productionRequestObserverUserIds is list
        && get(/databases/$(database)/documents/system_settings/$(resource.data.tenantId)).data.planSettings.productionRequestObserverUserIds.hasAny([request.auth.uid]);
    }

    function pl_isOwnCreatedDoc() {
      return pl_authSignedIn()
        && 'createdBy' in resource.data
        && resource.data.createdBy == request.auth.uid;
    }

    function pl_isOwnCreatedWrite() {
      return pl_authSignedIn()
        && 'createdBy' in request.resource.data
        && request.resource.data.createdBy == request.auth.uid;
    }

    function pl_isOwnApprovalCreatorCancellationUpdate() {
      return pl_isOwnCreatedDoc()
        && resource.data.status == 'pending'
        && resource.data.currentStep == 0
        && request.resource.data.status == 'cancelled'
        && request.resource.data.currentStep == resource.data.currentStep
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'history'])
        && request.resource.data.history is list
        && resource.data.history is list
        && request.resource.data.history.size() == resource.data.history.size() + 1
        && (
          !('approvalChain' in resource.data)
          || resource.data.approvalChain.size() == 0
          || resource.data.approvalChain[0].status == 'pending'
        );
    }

    function pl_isOwnProductionApprovalCreatorCancellationUpdate() {
      return pl_isOwnCreatedDoc()
        && resource.data.status == 'pending'
        && resource.data.currentStep == 0
        && request.resource.data.status == 'cancelled'
        && request.resource.data.currentStep == resource.data.currentStep
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'history',
          'currentApproverEmployeeIds', 'currentApproverUserIds',
          'participantEmployeeIds', 'participantUserIds'
        ])
        && request.resource.data.history is list
        && resource.data.history is list
        && request.resource.data.history.size() == resource.data.history.size() + 1
        && (
          !('approvalChain' in resource.data)
          || resource.data.approvalChain.size() == 0
          || resource.data.approvalChain[0].status == 'pending'
        );
    }

    function pl_isOwnPendingSourceCancellationUpdate() {
      return pl_isOwnCreatedDoc()
        && (!('finalStatus' in resource.data) || resource.data.finalStatus == 'pending')
        && request.resource.data.finalStatus == 'rejected'
        && request.resource.data.status in ['pending', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalChain', 'finalStatus', 'status']);
    }

    function pl_isOwnNotification() {
      return pl_authSignedIn()
        && 'recipientUserId' in resource.data
        && resource.data.recipientUserId == request.auth.uid;
    }

    function pl_isSpecialHrWorkflowCollection(coll) {
      return coll in [
        'leave_requests', 'leave_balances', 'employee_loans', 'employee_deductions',
        'approval_requests', 'production_approval_requests', 'approval_delegations',
        'approval_audit_logs', 'hr_notifications'
      ];
    }

    function pl_isPresenceOwner(userId) {
      return pl_authSignedIn() && request.auth.uid == userId;
    }

    match /tenant_slugs/{slug} {
      allow read: if pl_authSignedIn();
      allow write: if pl_isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if pl_isActiveUser() && pl_currentUserDoc().data.tenantId == tenantId;
      allow read: if pl_isSuperAdmin();
      allow create, delete: if pl_isSuperAdmin();
      allow update: if pl_isSuperAdmin()
        || (pl_isActiveUser()
          && pl_currentUserDoc().data.tenantId == tenantId
          && pl_hasErpPermission('settings.edit')
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.status == resource.data.status);
    }

    match /pending_tenants/{id} {
      allow create: if pl_authSignedIn();
      allow read, update: if pl_isSuperAdmin();
      allow delete: if pl_isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if pl_authSignedIn() && request.auth.uid == userId;
      allow get: if pl_authSignedIn() && (
        pl_isSuperAdmin()
        || (pl_isActiveUser() && resource.data.tenantId == pl_currentUserDoc().data.tenantId
          && (pl_hasErpPermission('users.manage') || pl_hasErpPermission('roles.manage')))
      );
      allow list: if pl_authSignedIn() && (
        pl_isSuperAdmin()
        || (pl_isActiveUser() && (pl_hasErpPermission('users.manage') || pl_hasErpPermission('roles.manage')))
      );
      // Self-create is pending-only (least privilege). Privileged roleId/isActive
      // must be written by Admin SDK (adminCreateUser / bootstrapTenantAdmin / approve).
      allow create: if ((pl_authSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'roleId', 'tenantId', 'isActive'])
        && request.resource.data.isActive == false
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId.size() > 0
        && request.resource.data.roleId is string
        && (
          request.resource.data.roleId == ''
          || request.resource.data.roleId == request.resource.data.tenantId + '__inventory_viewer'
        )
        && (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false))
        || (pl_isSuperAdmin()
        && request.resource.data.keys().hasAll(['email', 'displayName', 'roleId', 'tenantId', 'isActive'])
        && (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == false)))
        && pl_validSearchPrefixes();
      // isSuperAdmin is never writable from clients (Admin SDK / trusted scripts only).
      allow update: if pl_authSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSuperAdmin'])
        && pl_validSearchPrefixes()
        && (
        (
          request.auth.uid == userId
          && resource.data.tenantId == pl_currentUserDoc().data.tenantId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'roleId',
            'tenantId',
            'isActive',
            'inventoryWarehouseId',
            'repairBranchId',
            'repairBranchIds',
          ])
        )
        || (pl_isActiveUser() && resource.data.tenantId == pl_currentUserDoc().data.tenantId
          && (pl_hasErpPermission('users.manage') || pl_hasErpPermission('roles.manage'))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenantId']))
        || pl_isSuperAdmin()
      );
      allow delete: if pl_isSuperAdmin()
        || (pl_isActiveUser() && resource.data.tenantId == pl_currentUserDoc().data.tenantId
          && pl_hasErpPermission('users.manage'));
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if pl_authSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/preferences/{prefId} {
      allow read, write: if pl_authSignedIn() && request.auth.uid == userId;
    }

    match /roles/{roleId} {
      allow read: if pl_authSignedIn() && (
        pl_isSuperAdmin()
        || (exists(pl_currentUserPath()) && resource.data.tenantId == pl_currentUserDoc().data.tenantId)
      );
      /* Super-admin approves pending companies: seedIfEmpty() creates roles for the NEW tenantId â€” tenant admins use roles.manage on their own tenant. */
      allow create: if pl_isSuperAdmin()
        || (pl_isActiveUser() && pl_hasErpPermission('roles.manage') && pl_sameTenantWrite());
      /* Updates must keep tenantId stable. Deletes have no request.resource â€” pl_sameTenantUpdate() always fails for delete. */
      allow update: if pl_isSuperAdmin()
        || (pl_isActiveUser() && pl_hasErpPermission('roles.manage') && pl_sameTenantUpdate());
      allow delete: if pl_isSuperAdmin()
        || (pl_isActiveUser() && pl_hasErpPermission('roles.manage')
          && resource.data.tenantId == pl_currentUserDoc().data.tenantId);
    }

    match /dashboardStats/{tenantId}/daily/{dayId} {
      allow read: if pl_isActiveUser() && pl_currentUserDoc().data.tenantId == tenantId;
      allow write: if false;
    }

    match /dashboardStats/{tenantId}/monthly/{monthId} {
      allow read: if pl_isActiveUser() && pl_currentUserDoc().data.tenantId == tenantId;
      allow write: if false;
    }

    match /dashboardStats/{tenantId}/products/{productId} {
      allow read: if pl_isActiveUser() && pl_currentUserDoc().data.tenantId == tenantId;
      allow write: if false;
    }

    match /dashboardStats/{tenantId}/productMonths/{summaryId} {
      allow read: if pl_isActiveUser() && pl_currentUserDoc().data.tenantId == tenantId;
      allow write: if false;
    }

    // Alias hardening for snake_case naming in old docs/references.
    match /dashboard_stats/{tenantId}/{docId} {
      allow read: if pl_isActiveUser() && pl_currentUserDoc().data.tenantId == tenantId;
      allow write: if false;
    }

    match /audit_logs/{docId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      // Client audit creates must carry a fixed schema; free-form forgery is rejected.
      allow create: if pl_isActiveUser()
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId
        && request.resource.data.keys().hasAll(['tenantId', 'action', 'entityType', 'timestamp'])
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 120
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() > 0
        && request.resource.data.entityType.size() <= 80
        && (!('performedBy' in request.resource.data)
          || request.resource.data.performedBy == request.auth.uid
          || request.resource.data.performedBy == 'system');
      allow update, delete: if false;
    }

    match /audit_logs/{docId}/{subPath=**} {
      allow read: if pl_isActiveUser();
      allow write: if false;
    }

    // Same tenant isolation as pl_isErpBusinessCollection writes, but NOT listed there so
    // generic delete (open on many collections) does not apply to financial snapshots.
    function pl_costPeriodIsOpen(tenantId, month) {
      return !exists(
        /databases/$(database)/documents/cost_period_closures/$(tenantId + '__' + month)
      );
    }

    match /monthly_production_costs/{docId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyWrite()
        && pl_costPeriodIsOpen(request.resource.data.tenantId, request.resource.data.month);
      allow update: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyUpdate()
        && request.resource.data.month == resource.data.month
        && pl_costPeriodIsOpen(resource.data.tenantId, resource.data.month);
      allow delete: if false;
    }

    // Alias for requested monthly_costs naming.
    match /monthly_costs/{docId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyWrite()
        && pl_costPeriodIsOpen(request.resource.data.tenantId, request.resource.data.month);
      allow update: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyUpdate()
        && request.resource.data.month == resource.data.month
        && pl_costPeriodIsOpen(resource.data.tenantId, resource.data.month);
      allow delete: if false;
    }

    match /cost_centers/{docId} {
      allow read: if (
        pl_hasErpPermission('costs.view')
        || pl_hasErpPermission('costs.manage')
        || pl_hasErpPermission('accounting.view')
        || pl_hasErpPermission('accounting.settings.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /cost_center_values/{docId} {
      allow read: if (
        pl_hasErpPermission('costs.view') || pl_hasErpPermission('costs.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyWrite()
        && pl_costPeriodIsOpen(request.resource.data.tenantId, request.resource.data.month);
      allow update: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyUpdate()
        && request.resource.data.month == resource.data.month
        && pl_costPeriodIsOpen(resource.data.tenantId, resource.data.month);
      allow delete: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyRead()
        && pl_costPeriodIsOpen(resource.data.tenantId, resource.data.month);
    }

    match /cost_allocations/{docId} {
      allow read: if (
        pl_hasErpPermission('costs.view') || pl_hasErpPermission('costs.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyWrite()
        && pl_costPeriodIsOpen(request.resource.data.tenantId, request.resource.data.month);
      allow update: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyUpdate()
        && request.resource.data.month == resource.data.month
        && pl_costPeriodIsOpen(resource.data.tenantId, resource.data.month);
      allow delete: if pl_hasErpPermission('costs.manage')
        && pl_sameTenantOrLegacyRead()
        && pl_costPeriodIsOpen(resource.data.tenantId, resource.data.month);
    }

    match /cost_period_closures/{docId} {
      allow read: if (
        pl_hasErpPermission('costs.view')
        || pl_hasErpPermission('costs.manage')
        || pl_hasErpPermission('accounting.view')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /user_presence/{userId} {
      allow read: if pl_hasErpPermission('activityLog.view') || pl_hasErpPermission('roles.manage');
      allow create, update, delete: if pl_isPresenceOwner(userId);
    }

    match /user_devices/{tokenId} {
      allow read: if pl_authSignedIn()
        && (resource.data.userId == request.auth.uid || pl_hasErpPermission('roles.manage'));
      allow create: if pl_authSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if pl_authSignedIn()
        && (resource.data.userId == request.auth.uid || pl_hasErpPermission('roles.manage'));
    }

    match /payroll_months/{monthId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create: if pl_hasErpPermission('payroll.generate')
        && pl_sameTenantOrLegacyWrite()
        && pl_validSearchPrefixes();
      allow delete: if pl_hasErpPermission('payroll.generate') && pl_sameTenantOrLegacyRead();
      allow update: if (pl_hasErpPermission('payroll.generate')
        || pl_hasErpPermission('payroll.finalize')
        || pl_hasErpPermission('payroll.lock'))
        && pl_sameTenantOrLegacyUpdate()
        && pl_validSearchPrefixes();
    }

    match /payroll_records/{recordId} {
      allow read: if (pl_hasErpPermission('payroll.view')
        || pl_hasErpPermission('payroll.generate')
        || pl_hasErpPermission('payroll.finalize')
        || pl_hasErpPermission('payroll.lock')
        || pl_hasErpPermission('payroll.accounts.view')
        || pl_hasErpPermission('payroll.accounts.disburse'))
        && pl_sameTenantOrLegacyRead();
      allow create: if pl_hasErpPermission('payroll.generate')
        && pl_sameTenantOrLegacyWrite()
        && pl_validSearchPrefixes();
      allow delete: if pl_hasErpPermission('payroll.generate') && pl_sameTenantOrLegacyRead();
      allow update: if (
          pl_hasErpPermission('payroll.generate')
          || pl_hasErpPermission('payroll.finalize')
          || pl_hasErpPermission('payroll.lock')
          || pl_hasErpPermission('payroll.accounts.disburse')
        )
        && pl_sameTenantOrLegacyUpdate()
        && pl_validSearchPrefixes();
    }

    match /payroll_audit_logs/{logId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create: if (pl_hasErpPermission('payroll.generate')
        || pl_hasErpPermission('payroll.finalize')
        || pl_hasErpPermission('payroll.lock'))
        && pl_sameTenantOrLegacyWrite();
    }

    match /payroll_cost_summary/{summaryId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create, update: if (pl_hasErpPermission('payroll.finalize')
        || pl_hasErpPermission('payroll.lock'))
        && pl_sameTenantOrLegacyWrite();
      allow delete: if (pl_hasErpPermission('payroll.finalize')
        || pl_hasErpPermission('payroll.lock'))
        && pl_sameTenantOrLegacyRead();
    }

    match /payroll_distributions/{distributionId} {
      allow read: if (pl_hasErpPermission('payroll.view') || pl_hasErpPermission('payroll.accounts.view')) && pl_sameTenantOrLegacyRead();
      allow create, update: if pl_hasErpPermission('payroll.accounts.disburse') && pl_sameTenantOrLegacyWrite();
      allow delete: if pl_hasErpPermission('payroll.accounts.disburse') && pl_sameTenantOrLegacyRead();
    }

    match /repair_branches/{id} {
      allow read: if pl_sameTenantOrLegacyRead() && (
        pl_isRepairBranchAdmin()
        || pl_hasErpPermission('repair.view')
        || pl_hasErpPermission('repair.dashboard.view')
        || pl_hasErpPermission('repair.jobs.technician')
        || pl_hasErpPermission('repair.parts.view')
        || pl_hasErpPermission('repair.parts.manage')
        || pl_hasErpPermission('repairSpareIssues.view')
        || pl_hasErpPermission('repairSpareIssues.create')
        || pl_hasErpPermission('repair.treasury.view')
        || pl_hasErpPermission('repair.treasury.manage')
        || pl_hasErpPermission('repair.salesInvoice.create')
        || pl_hasErpPermission('repair.salesInvoice.view')
        || pl_hasErpPermission('repair.customerRequests.view')
        || pl_hasErpPermission('repair.custody.view')
        || pl_hasErpPermission('repair.replacements.view')
      );
      allow create, update: if pl_isRepairBranchAdmin() && pl_sameTenantOrLegacyWrite();
      allow delete: if pl_isRepairBranchAdmin() && pl_sameTenantOrLegacyRead();
    }

    match /repair_jobs/{id} {
      allow read: if (
        (
          pl_hasErpPermission('repair.view')
          || pl_hasErpPermission('repair.jobs.reception')
        ) && pl_canReadRepairBranchScoped()
      );
      allow create: if pl_hasErpPermission('repair.jobs.create')
        && pl_canCreateRepairBranchScoped()
        && request.resource.data.get('customerId', '') is string
        && request.resource.data.get('customerId', '').size() > 0
        && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
        && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.tenantId == pl_tenantId();
      allow update: if (
        pl_hasErpPermission('repair.jobs.edit')
        || pl_hasErpPermission('repair.jobs.reception')
      ) && pl_canUpdateRepairBranchScoped()
        && pl_repairJobTechnicianSelfAssignOk();
      allow delete: if pl_hasErpPermission('repair.jobs.delete') && pl_canReadRepairBranchScoped();
    }

    /**
     * Assigned technician may read events under their job via path scope.
     * Do not require pl_canReadRepairBranchScoped here: list queries on the
     * subcollection have no branchId filter and would fail closed incorrectly.
     */
    function pl_isAssignedRepairJobTechnician(jobId) {
      return pl_hasErpPermission('repair.jobs.technician')
        && exists(/databases/$(database)/documents/repair_jobs/$(jobId))
        && get(/databases/$(database)/documents/repair_jobs/$(jobId)).data.tenantId == pl_tenantId()
        && get(/databases/$(database)/documents/repair_jobs/$(jobId)).data.get('technicianId', '') == request.auth.uid;
    }

    match /repair_jobs/{jobId}/service_events/{eventId} {
      allow read: if (
        (
          pl_hasErpPermission('repair.view')
          || pl_hasErpPermission('repair.jobs.reception')
        ) && pl_canReadRepairBranchScoped()
      ) || pl_isAssignedRepairJobTechnician(jobId);
      allow create: if (
        pl_hasErpPermission('repair.jobs.create')
        || pl_hasErpPermission('repair.jobs.edit')
        || pl_hasErpPermission('repair.jobs.reception')
        || pl_isAssignedRepairJobTechnician(jobId)
      ) && pl_canCreateRepairBranchScoped();
      allow update: if pl_hasErpPermission('repair.jobs.edit') && pl_canUpdateRepairBranchScoped();
      allow delete: if pl_hasErpPermission('repair.jobs.delete') && pl_canReadRepairBranchScoped();
    }

    // Financial documents are server-managed and field-separated from the
    // technical job so technicians cannot read prices or payment information.
    match /repair_job_financials/{id} {
      allow read: if pl_hasErpPermission('repair.finance.view') && pl_canReadRepairBranchScoped();
      allow create, update, delete: if false;
    }

    match /repair_payment_authorizations/{id} {
      allow read: if (
        pl_hasErpPermission('repair.payments.view')
        || pl_hasErpPermission('repair.finance.view')
        || pl_hasErpPermission('repair.discounts.approve')
        || pl_hasErpPermission('repair.credit.approve')
      ) && pl_canReadRepairBranchScoped();
      allow create, update, delete: if false;
    }

    match /repair_payments/{id} {
      allow read: if (
        pl_hasErpPermission('repair.payments.view')
        || pl_hasErpPermission('repair.finance.view')
      ) && pl_canReadRepairBranchScoped();
      allow create, update, delete: if false;
    }

    match /repair_financial_approvals/{id} {
      allow read: if (
        pl_hasErpPermission('repair.discounts.request')
        || pl_hasErpPermission('repair.discounts.approve')
        || pl_hasErpPermission('repair.credit.request')
        || pl_hasErpPermission('repair.credit.approve')
      ) && pl_canReadRepairBranchScoped();
      allow create, update, delete: if false;
    }

    match /accounting_accounts/{id} {
      allow read: if (
        pl_hasErpPermission('accounting.view')
        || pl_hasErpPermission('accounting.accounts.manage')
        || pl_hasErpPermission('repair.finance.view')
        || pl_hasErpPermission('repair.accounting.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /accounting_journal_entries/{id} {
      allow read: if (
        pl_hasErpPermission('accounting.view')
        || pl_hasErpPermission('accounting.settings.manage')
        || pl_hasErpPermission('accounting.journals.post')
        || pl_hasErpPermission('repair.finance.view')
        || pl_hasErpPermission('repair.accounting.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /accounting_settings/{id} {
      allow read: if pl_hasErpPermission('accounting.view') && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /accounting_periods/{id} {
      allow read: if pl_hasErpPermission('accounting.view') && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /accounting_posting_outbox/{id} {
      allow read: if (
        pl_hasErpPermission('accounting.view')
        || pl_hasErpPermission('accounting.settings.manage')
        || pl_hasErpPermission('accounting.journals.post')
        || pl_hasErpPermission('repair.finance.view')
        || pl_hasErpPermission('repair.accounting.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /accounting_audit_log/{id} {
      allow read: if (
        pl_hasErpPermission('accounting.view')
        || pl_hasErpPermission('accounting.settings.manage')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    match /accounting_sequences/{id} {
      allow read, create, update, delete: if false;
    }

    match /repair_financial_migration_reviews/{id} {
      allow read: if (
        pl_hasErpPermission('repair.finance.view')
        || pl_hasErpPermission('repair.accounting.manage')
      ) && pl_canReadRepairBranchScoped();
      allow create, update, delete: if false;
    }

    match /repair_service_catalog/{id} {
      allow read: if (
        pl_hasErpPermission('repair.settings.manage')
        || pl_hasErpPermission('repair.finance.view')
        || pl_hasErpPermission('repair.payments.view')
      ) && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    // Written only by updateRepairPartsPricing (Admin SDK). Clients must not
    // forge or wipe commercial pricing audit history.
    match /repair_parts_pricing_audit/{id} {
      allow read: if pl_hasErpPermission('repair.pricing.manage') && pl_sameTenantOrLegacyRead();
      allow create, update, delete: if false;
    }

    // A technician account receives a sanitized repair catalog through a
    // callable. Firestore cannot hide individual price fields, so direct
    // material reads are denied unless the account also has a commercial or
    // inventory-management permission.
    match /materials/{id} {
      allow read: if (
        !pl_hasErpPermission('repair.jobs.technician')
        || pl_hasErpPermission('repair.pricing.manage')
        || pl_hasErpPermission('inventory.view')
        || pl_hasErpPermission('inventory.transactions.create')
        || pl_hasErpPermission('manufacturing.materials.manage')
      ) && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if (
        !pl_hasErpPermission('repair.jobs.technician')
        || pl_hasErpPermission('manufacturing.materials.manage')
      ) && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk())
        && pl_validSearchPrefixes();
      allow update: if (
        !pl_hasErpPermission('repair.jobs.technician')
        || pl_hasErpPermission('manufacturing.materials.manage')
      ) && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk())
        && pl_validSearchPrefixes();
      allow delete: if (
        !pl_hasErpPermission('repair.jobs.technician')
        || pl_hasErpPermission('manufacturing.materials.manage')
      ) && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
    }

    match /repair_followups/{id} {
      allow read: if pl_hasErpPermission('repair.view') && pl_canReadRepairBranchScoped();
      allow create: if pl_hasErpPermission('repair.view') && pl_canCreateRepairBranchScoped();
      allow update, delete: if false;
    }

    match /repair_part_reservations/{id} {
      allow read: if pl_hasErpPermission('repair.parts.view') && pl_canReadRepairBranchScoped();
      allow create, update: if pl_hasErpPermission('repair.parts.manage') && pl_canCreateRepairBranchScoped();
      allow delete: if pl_hasErpPermission('repair.parts.manage') && pl_canReadRepairBranchScoped();
    }

    match /repair_spare_parts/{id} {
      allow read: if pl_hasErpPermission('repair.parts.view') && pl_canReadRepairBranchScoped();
      allow create, update: if pl_hasErpPermission('repair.parts.manage')
        && pl_canCreateRepairBranchScoped()
        && pl_repairSparePartMaterialLinkOk();
      allow delete: if pl_canAdjustRepairCenterStock() && pl_canReadRepairBranchScoped();
    }

    match /repair_spare_parts_stock/{id} {
      allow read: if pl_hasErpPermission('repair.parts.view') && pl_canReadRepairBranchScoped();
      // Center managers may seed qty=0 when adding a catalog part; qty changes need stockAdjust (or elevated).
      allow create: if pl_canCreateRepairBranchScoped()
        && (
          pl_canAdjustRepairCenterStock()
          || (
            pl_hasErpPermission('repair.parts.manage')
            && request.resource.data.get('quantity', 0) == 0
          )
        );
      allow update: if pl_canAdjustRepairCenterStock() && pl_canCreateRepairBranchScoped();
      allow delete: if pl_canAdjustRepairCenterStock() && pl_canReadRepairBranchScoped();
    }

    match /repair_parts_transactions/{id} {
      allow read: if pl_hasErpPermission('repair.parts.view') && pl_canReadRepairBranchScoped();
      allow create: if pl_canCreateRepairBranchScoped()
        && (
          pl_canAdjustRepairCenterStock()
          || pl_hasErpPermission('repair.parts.manage')
        );
      allow update, delete: if false;
    }

    match /repair_treasury_sessions/{id} {
      allow read: if (
          pl_hasErpPermission('repair.treasury.view')
          || pl_hasErpPermission('repair.treasury.manage')
        ) && pl_canReadRepairBranchScoped();
      allow create: if pl_hasErpPermission('repair.treasury.manage') && pl_canCreateRepairBranchScoped();
      allow update: if pl_hasErpPermission('repair.treasury.manage') && pl_canUpdateRepairBranchScoped();
      allow delete: if false;
    }

    match /repair_treasury_entries/{id} {
      allow read: if (
          pl_hasErpPermission('repair.treasury.view')
          || pl_hasErpPermission('repair.treasury.manage')
        ) && pl_canReadRepairBranchScoped();
      allow create: if pl_hasErpPermission('repair.treasury.manage')
        && pl_canCreateRepairBranchScoped()
        && pl_canCreateRepairTreasuryEntryForOpenSession();
      allow update, delete: if false;
    }

    // Expense requests are server-managed. A treasury operator may submit one,
    // but only the callable admin approval path can post it as a real entry.
    match /repair_treasury_expense_requests/{id} {
      allow read: if pl_hasErpPermission('repair.treasury.manage')
        && pl_canReadRepairBranchScoped();
      allow create, update, delete: if false;
    }

    // get of a missing close doc must succeed (resource == null) so monthly report
    // can treat "no close row" as open — pl_canReadRepairBranchScoped alone denies misses.
    match /repair_treasury_month_closes/{id} {
      allow read: if (
          pl_hasErpPermission('repair.treasury.view')
          || pl_hasErpPermission('repair.treasury.manage')
        )
        && pl_sameTenantOrLegacyRead()
        && (
          pl_isRepairBranchAdmin()
          || resource == null
          || (
            'branchId' in resource.data
            && pl_canAccessRepairBranch(resource.data.branchId)
          )
        );
      allow create: if pl_hasErpPermission('repair.treasury.manage') && pl_canCreateRepairBranchScoped();
      allow update: if pl_hasErpPermission('repair.treasury.manage') && pl_canUpdateRepairBranchScoped();
      allow delete: if false;
    }

    match /repair_sales_invoices/{id} {
      allow read: if (
          pl_hasErpPermission('repair.salesInvoice.view')
          || pl_hasErpPermission('repair.salesInvoice.create')
        ) && pl_canReadRepairBranchScoped();
      // Financial/inventory lifecycle is server-managed. This prevents clients
      // from overriding prices, approval state, stock, treasury or journals.
      allow create, update, delete: if false;
    }

    // Server-managed atomic sequence counters. Clients may include them in a
    // tenant backup, but invoice numbering can only be mutated by Admin SDK.
    match /repair_counters/{id} {
      allow read: if pl_sameTenantOrLegacyRead() || pl_isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /repair_complaints/{id} {
      allow read: if pl_hasErpPermission('repair.complaints.view') && pl_canReadRepairComplaintScoped();
      allow create: if pl_hasErpPermission('repair.complaints.manage') && pl_canWriteRepairComplaintScoped();
      allow update: if pl_hasErpPermission('repair.complaints.manage') && pl_canUpdateRepairComplaintScoped();
      allow delete: if false;
    }

    // Customer portal intake and customer-owned product custody are server-owned.
    match /customer_service_requests/{id} {
      allow read: if pl_sameTenantOrLegacyRead()
        && (
          pl_hasErpPermission('repair.customerRequests.assign')
          || pl_hasErpPermission('repair.callCenter.viewAll')
          || (
            pl_hasErpPermission('repair.customerRequests.view')
            && resource.data.get('branchId', '') is string
            && pl_canAccessRepairBranch(resource.data.get('branchId', ''))
          )
        );
      allow create, update, delete: if false;
    }

    match /customer_service_events/{id} {
      allow read: if pl_sameTenantOrLegacyRead()
        && (
          pl_hasErpPermission('repair.customerRequests.view')
          || pl_hasErpPermission('repair.custody.view')
          || pl_hasErpPermission('repair.replacements.view')
          || pl_hasErpPermission('repair.view')
        );
      allow create, update, delete: if false;
    }

    match /repair_custody_records/{id} {
      allow read: if pl_sameTenantOrLegacyRead()
        && (
          pl_hasErpPermission('repair.custody.view')
          || pl_hasErpPermission('repair.custody.record')
          || pl_hasErpPermission('repair.custody.handover')
        )
        && (
          pl_canViewAllRepairBranches()
          || pl_canAccessRepairBranch(resource.data.get('branchId', ''))
        );
      allow create, update, delete: if false;
    }

    match /repair_replacement_requests/{id} {
      allow read: if pl_sameTenantOrLegacyRead()
        && (
          pl_hasErpPermission('repair.replacements.view')
          || pl_hasErpPermission('repair.replacements.create')
          || pl_hasErpPermission('repair.replacements.approve')
          || pl_hasErpPermission('repair.replacements.deliver')
        )
        && (
          pl_canViewAllRepairBranches()
          || pl_hasErpPermission('repair.replacements.approve')
          || pl_canAccessRepairBranch(resource.data.get('branchId', ''))
        );
      allow create, update, delete: if false;
    }

    match /customer_portal_credentials/{id} {
      allow read, write: if false;
    }

    match /customer_portal_sessions/{id} {
      allow read, write: if false;
    }

    match /customer_portal_login_limits/{id} {
      allow read, write: if false;
    }

    match /product_barcode_claims/{id} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead()
        && (pl_hasErpPermission('products.view') || pl_hasErpPermission('products.create') || pl_hasErpPermission('products.edit'));
      allow create: if pl_hasErpPermission('products.create') && pl_sameTenantOrLegacyWrite();
      allow update: if pl_hasErpPermission('products.edit') && pl_sameTenantOrLegacyUpdate();
      allow delete: if pl_hasErpPermission('products.edit') && pl_sameTenantOrLegacyRead();
    }

    match /_counters/{id} {
      allow read: if pl_isActiveUser()
        && resource.data.tenantId == pl_currentUserDoc().data.tenantId
        && pl_hasErpPermission('repair.jobs.create');
      allow create: if pl_isActiveUser()
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId
        && pl_hasErpPermission('repair.jobs.create');
      allow update: if pl_isActiveUser()
        && resource.data.tenantId == pl_currentUserDoc().data.tenantId
        && request.resource.data.tenantId == pl_currentUserDoc().data.tenantId
        && pl_hasErpPermission('repair.jobs.create');
      allow delete: if false;
    }


    match /production_routing_executions/{docId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create: if pl_isActiveUser() && pl_sameTenantOrLegacyWrite();
      allow update: if pl_isActiveUser() && pl_sameTenantOrLegacyUpdate()
        && resource.data.status != 'completed';
      allow delete: if pl_isActiveUser() && pl_sameTenantOrLegacyRead() && pl_hasErpPermission('routing.manage');
    }

    match /production_routing_execution_steps/{docId} {
      allow read: if pl_isActiveUser() && pl_sameTenantOrLegacyRead();
      allow create: if pl_isActiveUser() && pl_sameTenantOrLegacyWrite()
        && get(/databases/$(database)/documents/production_routing_executions/$(request.resource.data.executionId)).data.status != 'completed';
      allow update: if pl_isActiveUser() && pl_sameTenantOrLegacyUpdate()
        && get(/databases/$(database)/documents/production_routing_executions/$(resource.data.executionId)).data.status != 'completed';
      allow delete: if pl_isActiveUser() && pl_sameTenantOrLegacyRead()
        && (
          get(/databases/$(database)/documents/production_routing_executions/$(resource.data.executionId)).data.status != 'completed'
          || pl_hasErpPermission('routing.manage')
        );
    }

    match /production_report_uniques/{docId} {
      allow read: if pl_isActiveUser()
        && (
          !exists(/databases/$(database)/documents/production_report_uniques/$(docId))
          || !('tenantId' in resource.data)
          || resource.data.tenantId == pl_currentUserDoc().data.tenantId
          || pl_isSuperAdmin()
        );
      allow create: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
    }

    match /hr_config_modules/{moduleId} {
      allow read: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_canManageHrConfigModule(moduleId)
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_canManageHrConfigModule(moduleId)
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if false;
    }

    match /hr_config_audit_logs/{logId} {
      allow read: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_canCreateHrConfigAuditLog()
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update, delete: if false;
    }

    match /leave_balances/{docId} {
      allow read: if pl_isActiveUser()
        && pl_hasSupervisorRequestPermission()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_hasSupervisorRequestPermission()
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if (pl_hasErpPermission('leave.manage') || pl_hasErpPermission('approval.manage'))
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if false;
    }

    match /leave_requests/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_hasSupervisorRequestPermission() || pl_isOwnCreatedDoc())
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_hasSupervisorRequestPermission()
        && pl_isOwnCreatedWrite()
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if (pl_hasApprovalWritePermission() || pl_hasErpPermission('leave.manage') || pl_isOwnPendingSourceCancellationUpdate())
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isOwnCreatedDoc()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin())
        && (!('finalStatus' in resource.data) || resource.data.finalStatus == 'pending');
    }

    match /employee_loans/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_hasSupervisorRequestPermission() || pl_isOwnCreatedDoc())
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_hasSupervisorRequestPermission()
        && pl_isOwnCreatedWrite()
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if (pl_hasApprovalWritePermission() || pl_hasErpPermission('loan.manage') || pl_hasErpPermission('loan.disburse') || pl_isOwnPendingSourceCancellationUpdate())
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isOwnCreatedDoc()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin())
        && (!('finalStatus' in resource.data) || resource.data.finalStatus == 'pending');
    }

    match /employee_deductions/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_hasSupervisorRequestPermission() || pl_hasErpPermission('payroll.view'))
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if (pl_hasApprovalWritePermission() || pl_hasErpPermission('payroll.generate') || pl_hasErpPermission('hrSettings.edit'))
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if (pl_hasErpPermission('payroll.generate') || pl_hasErpPermission('hrSettings.edit'))
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if (pl_hasErpPermission('payroll.generate') || pl_hasErpPermission('hrSettings.edit'))
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
    }

    match /approval_requests/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_hasApprovalReadPermission() || pl_isOwnCreatedDoc() || pl_isApprovalParticipantDoc() || pl_isCurrentApprovalActorDoc())
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_hasSupervisorRequestPermission()
        && pl_isOwnCreatedWrite()
        && request.resource.data.keys().hasAll([
          'tenantId', 'requestType', 'employeeId', 'requestData', 'approvalChain',
          'currentStep', 'status', 'history', 'createdBy'
        ])
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if (pl_hasApprovalWritePermission() || pl_isCurrentApprovalActionUpdate() || pl_isOwnApprovalCreatorCancellationUpdate())
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if false;
    }

    match /approval_delegations/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_hasSupervisorRequestPermission() || pl_hasApprovalReadPermission())
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_hasErpPermission('approval.delegate')
        && pl_isOwnCreatedWrite()
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_hasErpPermission('approval.delegate')
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if false;
    }

    match /approval_audit_logs/{docId} {
      allow read: if pl_hasApprovalReadPermission()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if (pl_hasSupervisorRequestPermission() || pl_hasApprovalWritePermission())
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update, delete: if false;
    }

    match /hr_notifications/{docId} {
      allow read: if pl_isOwnNotification()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if (pl_hasSupervisorRequestPermission() || pl_hasApprovalWritePermission())
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isOwnNotification()
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk())
        && request.resource.data.recipientUserId == resource.data.recipientUserId;
      allow delete: if false;
    }

    match /production_approval_requests/{docId} {
      allow read: if pl_isActiveUser()
        && (
          pl_hasProductionApprovalReadAllPermission()
          || pl_isOwnCreatedDoc()
          || pl_isApprovalParticipantDoc()
          || pl_isCurrentApprovalActorDoc()
          || pl_isConfiguredProductionRequestObserverDoc()
        )
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if pl_hasSupervisorRequestPermission()
        && pl_isOwnCreatedWrite()
        && request.resource.data.keys().hasAll([
          'tenantId', 'requestType', 'employeeId', 'requestData', 'approvalChain',
          'currentStep', 'status', 'history', 'createdBy'
        ])
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk());
      allow update: if (pl_hasApprovalWritePermission() || pl_isCurrentApprovalActionUpdate() || pl_isOwnProductionApprovalCreatorCancellationUpdate())
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if false;
    }

    match /system_settings/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if (
          pl_isSuperAdmin()
          || (pl_isActiveUser()
            && (pl_hasErpPermission('settings.edit') || pl_hasErpPermission('roles.manage'))
            && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk()))
        );
      allow update: if (
          pl_isSuperAdmin()
          || (pl_isActiveUser()
            && (pl_hasErpPermission('settings.edit') || pl_hasErpPermission('roles.manage'))
            && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk()))
        );
      allow delete: if false;
    }

    // Department consumable issues: client read only; mutations via Admin SDK callables.
    match /department_consumable_issues/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin())
        && (
          pl_hasErpPermission('departmentConsumables.view')
          || pl_hasErpPermission('inventory.view')
          || pl_isSuperAdmin()
        )
        && pl_inventoryWarehouseUnboundOr(
          pl_canAccessInventoryWarehouse(resource.data.get('warehouseId', ''))
        );
      allow create, update, delete: if false;
    }

    // Repair spare issues: client read only; mutations via Admin SDK callables.
    // Keep permission/warehouse checks compact — dashboard uses getCountFromServer (list).
    match /repair_spare_issues/{docId} {
      allow read: if pl_isActiveUser()
        && (resource.data.tenantId == pl_tenantId() || pl_isSuperAdmin())
        && pl_canReadRepairSpareIssuePerm()
        && pl_inventoryWarehouseUnboundOr(
          pl_canAccessInventoryWarehouse(resource.data.get('warehouseId', ''))
        );
      allow create, update, delete: if false;
    }

    // Spare-parts replenishment: client read only; mutations via Admin SDK callables.
    match /spare_parts_replenishment_requests/{docId} {
      allow read: if pl_isActiveUser()
        && (resource.data.tenantId == pl_tenantId() || pl_isSuperAdmin())
        && pl_canReadSparePartsReplenishmentPerm()
        && pl_inventoryWarehouseUnboundOr(
          pl_canAccessInventoryWarehouse(resource.data.get('fromWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('toWarehouseId', ''))
        );
      allow create, update, delete: if false;
    }

    // Spare-parts purchase invoices: client read only; post via Admin SDK callable.
    match /spare_parts_purchase_invoices/{docId} {
      allow read: if pl_isActiveUser()
        && (resource.data.tenantId == pl_tenantId() || pl_isSuperAdmin())
        && pl_canReadSparePartsPurchaseInvoicePerm()
        && pl_inventoryWarehouseUnboundOr(
          pl_canAccessInventoryWarehouse(resource.data.get('warehouseId', ''))
        );
      allow create, update, delete: if false;
    }

    // Spare-parts recall (center → central): client read only; mutations via callables.
    match /spare_parts_recall_requests/{docId} {
      allow read: if pl_isActiveUser()
        && (resource.data.tenantId == pl_tenantId() || pl_isSuperAdmin())
        && (
          pl_isSuperAdmin()
          || (
            pl_rolePermMapOk()
            && (
              pl_rolePermTrue(pl_currentRoleDoc().data.permissions, 'sparePartsRecall.view')
              || pl_rolePermTrue(pl_currentRoleDoc().data.permissions, 'sparePartsRecall.create')
              || pl_rolePermTrue(pl_currentRoleDoc().data.permissions, 'sparePartsRecall.confirm')
              || pl_rolePermTrue(pl_currentRoleDoc().data.permissions, 'sparePartsRecall.cancel')
              || pl_rolePermTrue(pl_currentRoleDoc().data.permissions, 'sparePartsReplenishment.view')
              || pl_rolePermTrue(pl_currentRoleDoc().data.permissions, 'inventory.view')
            )
          )
        )
        && pl_inventoryWarehouseUnboundOr(
          pl_canAccessInventoryWarehouse(resource.data.get('fromWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('toWarehouseId', ''))
        );
      allow create, update, delete: if false;
    }

    // Packaging handover receipts: client read only; confirm via confirmProductionHandoverReceipt callable.
    match /production_handover_receipts/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin())
        && (
          pl_hasErpPermission('productionHandover.approve')
          || pl_hasErpPermission('inventory.transfers.approve')
          || pl_hasErpPermission('inventory.view')
          || pl_isSuperAdmin()
        )
        && (
          pl_canAccessInventoryWarehouse(resource.data.get('fromWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('toWarehouseId', ''))
          || pl_canAccessInventoryWarehouse(resource.data.get('warehouseId', ''))
        );
      allow create, update, delete: if false;
    }

    // Inventory warehouse-scoped collections (users.inventoryWarehouseId).
    match /warehouses/{docId} {
      // Split get/list: document-id equality cannot authorize a collection query.
      allow get: if pl_isActiveUser() && (
        pl_canReadWarehouseDoc(docId)
        || pl_canReadMaintenanceCenterWarehouseAsCentral()
        || pl_isSuperAdmin()
      );
      allow list: if pl_isActiveUser() && (
        pl_isSuperAdmin()
        || (!pl_isInventoryWarehouseBound() && pl_sameTenantOrLegacyRead())
        || pl_canReadMaintenanceCenterWarehouseAsCentral()
      );
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseDoc(docId) || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseDoc(docId) || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseDoc(docId) || pl_isSuperAdmin());
    }

    match /warehouse_racks/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /warehouse_locations/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /warehouse_location_settings/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /default_item_locations/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /stock_items/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.create')
          || pl_hasErpPermission('inventory.items.manage')
          || pl_hasErpPermission('inventory.counts.manage'))
        && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.create')
          || pl_hasErpPermission('inventory.items.manage')
          || pl_hasErpPermission('inventory.counts.manage')
          || pl_hasErpPermission('inventory.transactions.edit'))
        && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.items.manage') || pl_hasErpPermission('inventory.transactions.delete'))
        && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /stock_location_balances/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.create')
          || pl_hasErpPermission('inventory.items.manage')
          || pl_hasErpPermission('inventory.counts.manage'))
        && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.create')
          || pl_hasErpPermission('inventory.items.manage')
          || pl_hasErpPermission('inventory.counts.manage')
          || pl_hasErpPermission('inventory.transactions.edit'))
        && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.items.manage') || pl_hasErpPermission('inventory.transactions.delete'))
        && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /stock_transactions/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.create')
          || pl_hasErpPermission('inventory.counts.manage')
          || pl_hasErpPermission('productionIssue.create')
          || pl_hasErpPermission('productionIssue.approve')
          || pl_hasErpPermission('inventory.disassembly.manage'))
        && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.edit')
          || pl_hasErpPermission('inventory.transactions.create'))
        && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser()
        && pl_hasErpPermission('inventory.transactions.delete')
        && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /stock_counts/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      // Creation revalidates the warehouse balances in a server transaction.
      allow create: if false;
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /inventory_transfer_requests/{docId} {
      allow read: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.view')
          || pl_hasErpPermission('inventory.transactions.create')
          || pl_hasErpPermission('inventory.transfers.approve')
          || pl_isSuperAdmin())
        && (pl_canReadTransferWarehouses() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.create') || pl_isSuperAdmin())
        && (pl_canWriteTransferWarehouses() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transfers.approve') || pl_isSuperAdmin())
        && (pl_canUpdateTransferWarehouses() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser()
        && (pl_hasErpPermission('inventory.transactions.delete') || pl_isSuperAdmin())
        && (pl_canReadTransferWarehouses() || pl_isSuperAdmin());
    }

    match /production_issue_orders/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadIssueWarehouses() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteIssueWarehouses() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateIssueWarehouses() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadIssueWarehouses() || pl_isSuperAdmin());
    }

    match /component_compensation_requests/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /component_return_records/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /disassembly_orders/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadDisassemblyWarehouses() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteDisassemblyWarehouses() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateDisassemblyWarehouses() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadDisassemblyWarehouses() || pl_isSuperAdmin());
    }

    match /supplies_receipt_orders/{docId} {
      allow read: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
      allow create: if pl_isActiveUser() && (pl_canWriteWarehouseIdField() || pl_superAdminTenantScopedCreateOk());
      allow update: if pl_isActiveUser() && (pl_canUpdateWarehouseIdField() || pl_superAdminTenantScopedUpdateOk());
      allow delete: if pl_isActiveUser() && (pl_canReadWarehouseIdField() || pl_isSuperAdmin());
    }

    match /{coll}/{docId} {
      allow read: if !pl_isSpecialHrWorkflowCollection(coll) && pl_isErpBusinessCollection(coll)
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
      allow create: if !pl_isSpecialHrWorkflowCollection(coll) && pl_isErpBusinessCollection(coll)
        && (pl_sameTenantOrLegacyWrite() || pl_superAdminTenantScopedCreateOk())
        && pl_validSearchPrefixes();
      allow update: if !pl_isSpecialHrWorkflowCollection(coll) && pl_isErpBusinessCollection(coll)
        && (pl_sameTenantOrLegacyUpdate() || pl_superAdminTenantScopedUpdateOk())
        && pl_validSearchPrefixes();
      allow delete: if !pl_isSpecialHrWorkflowCollection(coll) && pl_isErpBusinessCollection(coll)
        && (pl_sameTenantOrLegacyRead() || pl_isSuperAdmin());
    }

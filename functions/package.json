{
  "name": "pro-tech-erp-functions",
  "private": true,
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "lint": "echo \"No function lint configured\"",
    "backfill:dashboardStats:dry": "npm run build && node lib/scripts/backfillDashboardStats.js --dry-run",
    "backfill:dashboardStats:apply": "npm run build && node lib/scripts/backfillDashboardStats.js --apply",
    "backfill:supervisorAssignments:dry": "npm run build && node lib/scripts/backfillSupervisorLineAssignments.js",
    "backfill:supervisorAssignments:apply": "npm run build && node lib/scripts/backfillSupervisorLineAssignments.js --apply",
    "backfill:tenantId:dry": "npm run build && node lib/scripts/backfillTenantId.js",
    "backfill:tenantId:apply": "npm run build && node lib/scripts/backfillTenantId.js --apply"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "form-data": "^2.5.6",
    "@tootallnate/once": "^2.0.1"
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActiveTenantUser() {
      return isSignedIn()
        && userDoc().data.isActive == true
        && userDoc().data.tenantId is string
        && userDoc().data.tenantId.size() > 0;
    }

    function currentTenantId() {
      return userDoc().data.tenantId;
    }

    function allowedModules() {
      return ['employees', 'products', 'production_batches', 'qc_reports', 'documents', 'repair_jobs'];
    }

    function permissionIsTrue(perms, key) {
      return key in perms && perms[key] == true;
    }

    function canReadQualityPhoto() {
      let roleId = userDoc().data.roleId;
      let rolePath = /databases/(default)/documents/roles/$(roleId);
      let role = firestore.get(rolePath).data;
      return userDoc().data.isSuperAdmin == true
        || (
          roleId is string
          && firestore.exists(rolePath)
          && role.tenantId == currentTenantId()
          && (
            permissionIsTrue(role.permissions, 'quality.photos.view')
            || (
              !('quality.photos.view' in role.permissions)
              && (
                permissionIsTrue(role.permissions, 'quality.secondSort.view')
                || permissionIsTrue(role.permissions, 'quality.view')
                || permissionIsTrue(role.permissions, 'quality.reports.view')
              )
            )
          )
        );
    }

    function canWriteQualityPhoto() {
      let roleId = userDoc().data.roleId;
      let rolePath = /databases/(default)/documents/roles/$(roleId);
      let role = firestore.get(rolePath).data;
      return userDoc().data.isSuperAdmin == true
        || (
          roleId is string
          && firestore.exists(rolePath)
          && role.tenantId == currentTenantId()
          && (
            permissionIsTrue(role.permissions, 'quality.photos.manage')
            || (
              !('quality.photos.manage' in role.permissions)
              && (
                permissionIsTrue(role.permissions, 'quality.secondSort.manage')
                || permissionIsTrue(role.permissions, 'quality.approve')
              )
            )
          )
        );
    }

    // Preferred multi-tenant path:
    // company/{tenantId}/{module}/{documentId}/{fileName}
    match /company/{tenantId}/{module}/{documentId}/{fileName} {
      allow read: if isActiveTenantUser()
        && tenantId == currentTenantId()
        && (
          (module in allowedModules() && module != 'quality')
          || (module == 'quality' && canReadQualityPhoto())
        );
      allow write: if isActiveTenantUser()
        && tenantId == currentTenantId()
        && request.resource.size < 15 * 1024 * 1024
        && (
          (module in allowedModules() && module != 'quality')
          || (module == 'quality' && canWriteQualityPhoto())
        );
    }

    // Legacy single-company path (compat). Authenticated only — migrate to tenant path.
    // Deny after Storage migration completes for all tenants.
    match /company/{module}/{documentId}/{fileName} {
      allow read: if isActiveTenantUser() && module in allowedModules();
      allow write: if false;
    }
  }
}
